#!/usr/bin/env bash

ADB=/usr/bin/adb
OFFICE_IP="192.168.1.39"
PORT=5555

# Remove dead/stale network transports
$ADB disconnect >/dev/null 2>&1

# 1. Try office Wi-Fi
$ADB connect "$OFFICE_IP:$PORT" >/dev/null 2>&1

if $ADB -s "$OFFICE_IP:$PORT" shell echo OK 2>/dev/null | grep -q OK; then
    exec scrcpy -s "$OFFICE_IP:$PORT" \
        --audio-source=playback \
        --audio-dup
fi

# 2. Try Motorola hotspot
HOTSPOT_IP=$(ip route | awk '/^default/ {print $3; exit}')

if [[ -n "$HOTSPOT_IP" ]]; then
    $ADB connect "$HOTSPOT_IP:$PORT" >/dev/null 2>&1

    if $ADB -s "$HOTSPOT_IP:$PORT" shell echo OK 2>/dev/null | grep -q OK; then
        exec scrcpy -s "$HOTSPOT_IP:$PORT" \
            --audio-source=playback \
            --audio-dup
    fi
fi

notify-send "SHUNYA Phone" "Motorola not reachable"
exit 1
