#!/usr/bin/env bash

ADB=/usr/bin/adb

# Already connected? Just launch.
if $ADB get-state >/dev/null 2>&1; then
    exec scrcpy --audio-source=playback --audio-dup
fi

# Room mode: phone is the hotspot.
# Its address is normally the default gateway.
PHONE_IP=$(ip route | awk '/^default/ {print $3; exit}')

if [[ -n "$PHONE_IP" ]]; then
    $ADB connect "$PHONE_IP:5555" >/dev/null 2>&1
fi

# Office/external Wi-Fi:
# ADB may discover the paired phone automatically via mDNS.
sleep 1

if $ADB get-state >/dev/null 2>&1; then
    exec scrcpy --audio-source=playback --audio-dup
fi

echo "Phone unavailable."
echo "Room/hotspot mode: run 'adb tcpip 5555' over USB once if necessary."
echo "Wi-Fi mode: enable Wireless debugging."
exit 1
