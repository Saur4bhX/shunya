#!/usr/bin/env bash
set -euo pipefail

THEME_FILE="$HOME/.config/shunya/theme.json"
HYPRLOCK_FILE="$HOME/.config/hypr/hyprlock.conf"

action="${1:-}"
accent_value="${2:-}"

case "$action" in
    dark|light|toggle|freeze-accent|auto-accent|set-accent)
        ;;
    *)
        echo "Usage: shunya-theme {dark|light|toggle|freeze-accent|auto-accent|set-accent [#RRGGBB]}" >&2
        exit 2
        ;;
esac


# ---------------------------------------------------------------------------
# Core SHUNYA theme state
# ---------------------------------------------------------------------------

python3 - "$THEME_FILE" "$HYPRLOCK_FILE" "$action" "$accent_value" <<'PY'
import json
import os
import sys
import tempfile
from pathlib import Path

theme_path = Path(sys.argv[1])
hyprlock_path = Path(sys.argv[2])
action = sys.argv[3]
accent_value = sys.argv[4]

data = json.loads(theme_path.read_text())


def update_auto_accent(data):
    if data.get("accentMode") != "auto":
        return

    wallpaper = data.get("wallpaper")
    if not wallpaper or not Path(wallpaper).is_file():
        return

    source_index = str(data.get("sourceColorIndex", 0))

    import subprocess

    result = subprocess.run(
        [
            "matugen",
            "image",
            wallpaper,
            "--source-color-index",
            source_index,
            "-j",
            "hex",
            "--dry-run",
        ],
        check=True,
        capture_output=True,
        text=True,
    )

    matugen_data = json.loads(result.stdout)
    colors = matugen_data["colors"]

    data.setdefault("dark", {})
    data.setdefault("light", {})

    data["dark"]["accent"] = colors["primary"]["dark"]["color"]
    data["light"]["accent"] = colors["primary"]["light"]["color"]

    data["dark"]["onAccent"] = colors["on_primary"]["dark"]["color"]
    data["light"]["onAccent"] = colors["on_primary"]["light"]["color"]


update_auto_accent(data)

current = data.get("mode", "dark")

if action == "set-accent":
    import re
    import subprocess

    if not re.fullmatch(r"#[0-9a-fA-F]{6}", accent_value):
        raise SystemExit("Accent must be in #RRGGBB format")

    result = subprocess.run(
        [
            "matugen",
            "color",
            "hex",
            accent_value,
            "-j",
            "hex",
            "--dry-run",
        ],
        check=True,
        capture_output=True,
        text=True,
    )

    colors = json.loads(result.stdout)["colors"]

    data["accentMode"] = "fixed"
    data["accentSource"] = accent_value.lower()

    data["dark"]["accent"] = colors["primary"]["dark"]["color"]
    data["light"]["accent"] = colors["primary"]["light"]["color"]

    data["dark"]["onAccent"] = colors["on_primary"]["dark"]["color"]
    data["light"]["onAccent"] = colors["on_primary"]["light"]["color"]

    mode = current

elif action == "auto-accent":
    data["accentMode"] = "auto"
    data.pop("accentSource", None)

    mode = current
    update_auto_accent(data)

elif action == "freeze-accent":
    data["accentMode"] = "fixed"
    mode = current

elif action == "toggle":
    mode = "light" if current == "dark" else "dark"

else:
    mode = action


if mode not in data:
    raise SystemExit(f"Palette '{mode}' is missing from theme.json")

data["mode"] = mode
palette = data[mode]


def atomic_write(path: Path, text: str):
    path.parent.mkdir(parents=True, exist_ok=True)

    fd, tmp = tempfile.mkstemp(
        prefix=f".{path.name}.",
        dir=path.parent,
        text=True,
    )

    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())

        os.replace(tmp, path)

    except Exception:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass

        raise


atomic_write(
    theme_path,
    json.dumps(data, indent=2) + "\n",
)


# ---------------------------------------------------------------------------
# Hyprlock
# ---------------------------------------------------------------------------

def rgba(value: str) -> str:
    return value.lstrip("#") + "ff"


font = data.get("fontFamily", "Noto Sans")

hyprlock = f"""# SHUNYA lockscreen
# Generated by ~/.config/bin/shunya-theme

background {{
    monitor =
    color = rgba({rgba(palette["background"])})
}}

label {{
    monitor =
    text = $TIME
    font_family = {font}
    font_size = 64
    color = rgba({rgba(palette["text"])})
    position = 0, 100
    halign = center
    valign = center
}}

input-field {{
    monitor =
    size = 320, 56
    outline_thickness = 2
    outer_color = rgba({rgba(palette["accent"])})
    inner_color = rgba({rgba(palette["surface"])})
    font_color = rgba({rgba(palette["text"])})
    font_family = {font}
    placeholder_text = Password
    fade_on_empty = false
    rounding = 8
    position = 0, -30
    halign = center
    valign = center
}}
"""

atomic_write(hyprlock_path, hyprlock)

print(mode)
PY


mode=$(python3 -c \
    'import json,sys; print(json.load(open(sys.argv[1]))["mode"])' \
    "$THEME_FILE"
)


# ---------------------------------------------------------------------------
# Qt5ct + Qt6ct palettes
# ---------------------------------------------------------------------------

python3 - "$THEME_FILE" <<'PY'
import json
import sys
from pathlib import Path

data = json.load(open(sys.argv[1]))
mode = data["mode"]


def argb(hex_color):
    return "#ff" + hex_color.lstrip("#")


def rgba50(hex_color):
    return "#80" + hex_color.lstrip("#")


def make_palette(p, disabled=False):
    text = argb(p["text"])
    background = argb(p["background"])
    surface = argb(p["surface"])
    alternate = argb(p.get("surfaceAlt", p["surface"]))
    border = argb(p["border"])

    accent = argb(p["accent"])
    on_accent = argb(p["onAccent"])

    if disabled:
        normal_text = rgba50(p["text"])
        highlighted_text = rgba50(p["onAccent"])
        tooltip_text = rgba50(p["text"])
        placeholder = rgba50(p["text"])
    else:
        normal_text = text
        highlighted_text = on_accent
        tooltip_text = text
        placeholder = rgba50(p["text"])

    colors = [
        normal_text,        # WindowText
        surface,            # Button
        border,             # Light
        border,             # Midlight
        background,         # Dark
        border,             # Mid
        normal_text,        # Text
        normal_text,        # BrightText
        normal_text,        # ButtonText
        surface,            # Base
        background,         # Window
        "#ff000000",        # Shadow
        accent,             # Highlight
        highlighted_text,   # HighlightedText
        accent,             # Link
        accent,             # LinkVisited
        alternate,          # AlternateBase
        "#ff000000",        # NoRole
        surface,            # ToolTipBase
        tooltip_text,       # ToolTipText
        placeholder,        # PlaceholderText
    ]

    return ", ".join(colors)


def update_appearance(text, values):
    lines = text.splitlines()

    output = []
    in_appearance = False
    appearance_found = False
    seen = set()

    for line in lines:
        stripped = line.strip()

        if stripped.startswith("[") and stripped.endswith("]"):
            if in_appearance:
                for key, value in values.items():
                    if key not in seen:
                        output.append(f"{key}={value}")

            in_appearance = stripped == "[Appearance]"

            if in_appearance:
                appearance_found = True
                seen = set()

            output.append(line)
            continue

        if in_appearance and "=" in line:
            key = line.split("=", 1)[0].strip()

            if key in values:
                output.append(f"{key}={values[key]}")
                seen.add(key)
                continue

        output.append(line)

    if in_appearance:
        for key, value in values.items():
            if key not in seen:
                output.append(f"{key}={value}")

    if not appearance_found:
        if output and output[-1] != "":
            output.append("")

        output.append("[Appearance]")

        for key, value in values.items():
            output.append(f"{key}={value}")

    return "\n".join(output).rstrip() + "\n"


for qt in ("qt5ct", "qt6ct"):
    qt6 = qt == "qt6ct"

    base = Path.home() / ".config" / qt
    colors_dir = base / "colors"

    colors_dir.mkdir(parents=True, exist_ok=True)

    for palette_mode in ("dark", "light"):
        palette = data[palette_mode]

        active = make_palette(
            palette,
            disabled=False,
        )

        inactive = make_palette(
            palette,
            disabled=False,
        )

        disabled = make_palette(
            palette,
            disabled=True,
        )
        palette_path = colors_dir / f"shunya-{palette_mode}.conf"

        palette_path.write_text(
            "[ColorScheme]\n"
            f"active_colors={active}\n"
            f"inactive_colors={inactive}\n"
            f"disabled_colors={disabled}\n"
        )

    selected = colors_dir / f"shunya-{mode}.conf"

    config = base / f"{qt}.conf"

    if config.exists():
        config_text = config.read_text()
    else:
        config_text = ""

    icon_theme = "breeze-dark" if mode == "dark" else "breeze"

    config_text = update_appearance(
        config_text,
        {
            "color_scheme_path": str(selected),
            "custom_palette": "true",
            "icon_theme": icon_theme,
            "style": "kvantum",
        },
    )

    config.parent.mkdir(parents=True, exist_ok=True)
    config.write_text(config_text)
PY


# ---------------------------------------------------------------------------
# Kvantum palette + SVG accent
# ---------------------------------------------------------------------------

python3 - "$THEME_FILE" <<'PY'
import json
import re
import sys
from pathlib import Path

data = json.load(open(sys.argv[1]))

themes = {
    "dark": (
        Path.home()
        / ".config/Kvantum/SHUNYA/SHUNYA.kvconfig"
    ),
    "light": (
        Path.home()
        / ".config/Kvantum/SHUNYA-Light/SHUNYA-Light.kvconfig"
    ),
}


for mode, path in themes.items():
    if not path.exists():
        continue

    palette = data[mode]
    text = path.read_text()

    replacements = {
        "highlight.color": palette["accent"],
        "inactive.highlight.color": palette["border"],
        "highlight.text.color": palette["onAccent"],
        "link.color": palette["accent"],
        "progress.indicator.text.color": palette["onAccent"],
    }

    for key, value in replacements.items():
        text = re.sub(
            rf"(?m)^{re.escape(key)}=.*$",
            f"{key}={value}",
            text,
        )

    # Section-specific Kvantum overrides.
        # Semantic Kvantum text colors.
    section_replacements = {
        "PanelButtonCommand": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["text"],
            "text.press.color": palette["onAccent"],
            "text.toggle.color": palette["onAccent"],
        },

        "Dock": {
            "text.normal.color": palette["text"],
        },

        "DockTitle": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["text"],
        },

        "IndicatorSpinBox": {
            "text.normal.color": palette["text"],
        },

        "RadioButton": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["text"],
        },

        "CheckBox": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["text"],
        },

        "ToolboxTab": {
            "text.normal.color": palette["text"],
            "text.press.color": palette["text"],
            "text.focus.color": palette["text"],
        },

        "Tab": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["text"],
            "text.toggle.color": palette["accent"],
        },

        "HeaderSection": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["accent"],
            "text.toggle.color": palette["text"],
        },

        "Toolbar": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["text"],
        },

        "Progressbar": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["text"],
            "text.press.color": palette["onAccent"],
            "text.toggle.color": palette["onAccent"],
        },

        "ItemView": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["text"],
            "text.press.color": palette["onAccent"],
            "text.toggle.color": palette["onAccent"],
        },

        "MenuItem": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["onAccent"],
        },

        "MenuBarItem": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["onAccent"],
        },

        "TitleBar": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["text"],
        },

        "ComboBox": {
            "text.press.color": palette["onAccent"],
        },

        "Menu": {
            "text.normal.color": palette["text"],
        },

        "GroupBox": {
            "text.normal.color": palette["text"],
            "text.focus.color": palette["text"],
        },
    }

    for section, values in section_replacements.items():
        for key, value in values.items():
            pattern = (
                rf"(?ms)(^\[{re.escape(section)}\]\s*$)"
                rf"(.*?)(?=^\[|\Z)"
            )

            def replace_section(match):
                header = match.group(1)
                body = match.group(2)

                body = re.sub(
                    rf"(?m)^{re.escape(key)}=.*$",
                    f"{key}={value}",
                    body,
                )

                return header + body

            text = re.sub(
                pattern,
                replace_section,
                text,
            )

    path.write_text(text)


# ---------------------------------------------------------------------------
# Kvantum SVG accent generation
# ---------------------------------------------------------------------------

svg_themes = {
    "dark": (
        Path.home()
        / ".config/Kvantum/SHUNYA/SHUNYA.svg"
    ),

    "light": (
        Path.home()
        / ".config/Kvantum/SHUNYA-Light/SHUNYA-Light.svg"
    ),
}

template_paths = {
    "dark": (
        Path.home()
        / "shunya/config/Kvantum/SHUNYA/SHUNYA.svg"
    ),

    "light": (
        Path.home()
        / "shunya/config/Kvantum/SHUNYA-Light/SHUNYA-Light.svg"
    ),
}

legacy_accents = (
    r"#5294e2|"
    r"#0582ff|"
    r"#0078f0|"
    r"#3176bf|"
    r"#4693e6|"
    r"#58acff"
)

for theme_mode, svg_path in svg_themes.items():
    template_path = template_paths[theme_mode]

    if not template_path.exists():
        continue

    accent = data[theme_mode]["accent"]

    svg = template_path.read_text()

    svg = re.sub(
        legacy_accents,
        accent,
        svg,
        flags=re.IGNORECASE,
    )

    svg_path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    svg_path.write_text(svg)
PY


# ---------------------------------------------------------------------------
# GTK / GNOME preference
# ---------------------------------------------------------------------------

if [[ "$mode" == "dark" ]]; then
    prefer_dark=1
    color_scheme="prefer-dark"
else
    prefer_dark=0
    color_scheme="prefer-light"
fi

mkdir -p \
    "$HOME/.config/gtk-3.0" \
    "$HOME/.config/gtk-4.0"

for gtk_dir in gtk-3.0 gtk-4.0; do
    cat > "$HOME/.config/$gtk_dir/settings.ini" <<EOF
[Settings]
gtk-application-prefer-dark-theme=$prefer_dark
gtk-font-name=Noto Sans 11
EOF
done

gsettings set \
    org.gnome.desktop.interface \
    color-scheme \
    "$color_scheme"

gsettings set \
    org.gnome.desktop.interface \
    font-name \
    'Noto Sans 11'


# ---------------------------------------------------------------------------
# GTK palette
# ---------------------------------------------------------------------------

python3 - "$THEME_FILE" <<'PY'
import json
import sys
from pathlib import Path

data = json.load(open(sys.argv[1]))
palette = data[data["mode"]]

css = f"""@define-color theme_bg_color {palette["background"]};
@define-color theme_fg_color {palette["text"]};
@define-color theme_base_color {palette["surface"]};
@define-color theme_text_color {palette["text"]};

@define-color theme_selected_bg_color {palette["accent"]};
@define-color theme_selected_fg_color {palette["onAccent"]};

@define-color borders {palette["border"]};

@define-color accent_color {palette["accent"]};
@define-color accent_bg_color {palette["accent"]};
@define-color accent_fg_color {palette["onAccent"]};

selection,
*:selected,
row:selected,
treeview.view:selected,
treeview.view:selected:focus,
iconview:selected,
list row:selected,
listbox row:selected,
listview row:selected,
columnview row:selected,
gridview child:selected {{
    background-color: @accent_bg_color;
    color: @accent_fg_color;
}}

scale highlight,
scale fill,
progressbar progress {{
    background-color: @accent_bg_color;
    border-color: @accent_bg_color;
}}

scale slider {{
    border-color: @accent_bg_color;
}}

popover row:selected,
popover listview row:selected,
popover modelbutton:hover,
popover modelbutton:focus,
menuitem:hover,
menuitem:focus {{
    background-color: @accent_bg_color;
    color: @accent_fg_color;
}}

notebook > header > tabs > tab:checked {{
    box-shadow: inset 0 -3px @accent_bg_color;
}}

notebook > header > tabs > tab:checked label {{
    color: @accent_color;
}}

window,
.background {{
    background-color: @theme_bg_color;
    color: @theme_fg_color;
}}
"""

for version in ("gtk-3.0", "gtk-4.0"):
    path = (
        Path.home()
        / ".config"
        / version
        / "gtk.css"
    )

    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    path.write_text(css)
PY

# ---------------------------------------------------------------------------
# Dolphin color scheme
# ---------------------------------------------------------------------------

if command -v kwriteconfig6 >/dev/null 2>&1; then
    if [[ "$mode" == "dark" ]]; then
        dolphin_scheme="KvDark"
    else
        dolphin_scheme="KvFlatLight"
    fi

    kwriteconfig6 \
        --file dolphinrc \
        --group UiSettings \
        --key ColorScheme \
        "$dolphin_scheme"
fi
# ---------------------------------------------------------------------------
# Activate Kvantum mode
# ---------------------------------------------------------------------------

if [[ "$mode" == "dark" ]]; then
    kvantummanager --set SHUNYA >/dev/null
else
    kvantummanager --set SHUNYA-Light >/dev/null
fi
