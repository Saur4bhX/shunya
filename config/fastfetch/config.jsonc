{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "none"
    },

    "display": {
        "separator": " ",

        "key": {
            "width": 11,
            "type": "string"
        },

        "percent": {
            "type": 9,
            "green": 50,
            "yellow": 80
        },

        "disableLinewrap": true,
        "showErrors": false
    },

    "modules": [
        {
            "type": "custom",
            "format": "── SYSTEM ─────────────────────────────",
            "outputColor": "bright_cyan"
        },

        {
            "type": "host",
            "key": "󰌢 Machine",
            "keyColor": "bright_cyan",
            "format": "{name:-22} {?version}({version:-12}){?}"
        },

        {
            "type": "cpu",
            "key": "󰍛 CPU",
            "keyColor": "bright_blue",
            "temp": true,
            "format": "{name:-19} @ {freq-max}"
        },

        {
            "type": "cpu",
            "key": "󰍛 Temp",
            "keyColor": "bright_red",
            "temp": true,
            "format": "{temperature}"
        },

        {
            "type": "cpuusage",
            "key": "󰍛 Load",
            "keyColor": "bright_yellow",
            "format": "{avg}"
        },

        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "bright_magenta",
            "format": "{name:-24} {?frequency}@ {frequency}{?}"
        },

        {
            "type": "display",
            "key": "󰍹 Display",
            "keyColor": "bright_blue",
            "format": "{width}x{height} @ {refresh-rate} Hz"
        },

        {
            "type": "memory",
            "key": "󰘚 Memory",
            "keyColor": "bright_magenta",
            "format": "{used} / {total} ({percentage})"
        },

        {
            "type": "custom",
            "format": "── POWER / AUDIO ──────────────────────",
            "outputColor": "bright_green"
        },

        {
            "type": "battery",
            "key": "󰁹 Battery",
            "keyColor": "bright_green",
            "format": "{capacity} [{status}]"
        },

        {
            "type": "sound",
            "key": "󰕾 Sound",
            "keyColor": "bright_yellow",
            "format": "{name:-22} ({volume-percentage})"
        },

        {
            "type": "custom",
            "format": "── STORAGE / NETWORK ──────────────────",
            "outputColor": "bright_blue"
        },

        {
            "type": "disk",
            "key": "󰋊 Disk",
            "keyColor": "bright_blue",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },

        {
            "type": "wifi",
            "key": "󰖩 Wi-Fi",
            "keyColor": "bright_cyan",
            "format": "{ssid:-18} {band} GHz ({signal-quality})"
        },

        {
            "type": "custom",
            "format": "── SHUNYA ─────────────────────────────",
            "outputColor": "bright_magenta"
        },

        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "bright_magenta"
        },

        {
            "type": "kernel",
            "key": "󰒋 Kernel",
            "keyColor": "bright_blue",
            "format": "{release}"
        },

        {
            "type": "wm",
            "key": "󰖲 WM",
            "keyColor": "bright_cyan",
            "format": "{pretty-name} {version}"
        },

        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "bright_green",
            "format": "{pretty-name} {version}"
        },

        {
            "type": "terminal",
            "key": "󰆍 Terminal",
            "keyColor": "bright_yellow",
            "format": "{pretty-name} {version}"
        },

        {
            "type": "uptime",
            "key": "󰔟 Uptime",
            "keyColor": "bright_cyan"
        }
    ]
}
