{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",

        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        },

        "color": {
            "1": "cyan",
            "2": "blue"
        }
    },

    "display": {
        "separator": "  ",

        "key": {
            "width": 10
        },

        "color": {
            "keys": "cyan"
        },

        "percent": {
            "type": 9
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "──── SYSTEM ─────────────────────────────",
            "outputColor": "cyan"
        },

        {
            "type": "host",
            "key": "Machine"
        },

        {
            "type": "cpu",
            "key": "CPU",
            "temp": true,
            "format": "{name} @ {freq-max} [{temperature}]"
        },

        {
            "type": "cpuusage",
            "key": "CPU Load"
        },

        {
            "type": "gpu",
            "key": "GPU"
        },

        {
            "type": "display",
            "key": "Display"
        },

        {
            "type": "memory",
            "key": "Memory"
        },

        "break",

        {
            "type": "custom",
            "format": "──── POWER & AUDIO ──────────────────────",
            "outputColor": "cyan"
        },

        {
            "type": "battery",
            "key": "Battery"
        },

        {
            "type": "sound",
            "key": "Sound"
        },

        "break",

        {
            "type": "custom",
            "format": "──── STORAGE & NETWORK ──────────────────",
            "outputColor": "cyan"
        },

        {
            "type": "disk",
            "key": "Disk"
        },

        {
            "type": "wifi",
            "key": "Wi-Fi"
        },

        "break",

        {
            "type": "custom",
            "format": "──── SHUNYA ─────────────────────────────",
            "outputColor": "cyan"
        },

        {
            "type": "os",
            "key": "OS"
        },

        {
            "type": "kernel",
            "key": "Kernel"
        },

        {
            "type": "wm",
            "key": "WM"
        },

        {
            "type": "shell",
            "key": "Shell"
        },

        {
            "type": "terminal",
            "key": "Terminal"
        },

        "break",

        {
            "type": "custom",
            "format": "──── SESSION ────────────────────────────",
            "outputColor": "cyan"
        },

        {
            "type": "uptime",
            "key": "Uptime"
        }
    ]
}
